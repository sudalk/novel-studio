# mock：不调用外部 API，用规则拆解、合成音和占位插画跑通全流程
# live：按下面的提供方调用真实服务
APP_MODE=mock

# 留空时：mock 模式用 mock；live 模式文本用 openai，语音用 mosi，图像用 openai
# 也可以在 mock 模式下单独把 TTS_PROVIDER 设为 mosi，只把配音换成真实接口
LLM_PROVIDER=
TTS_PROVIDER=
IMAGE_PROVIDER=

DATABASE_URL=sqlite:///./data/studio.db
DATA_DIR=./data

# true 时接口会等任务跑完再返回（测试和 python -m app.demo 使用）。日常保持 false。
JOBS_INLINE=false

# 文本大模型，OpenAI 兼容的 Chat Completions
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 图像。OpenAI 兼容的 images/generations。密钥只放这里，不要写进仓库。
# 默认中转：https://api.aicoming.top/v1
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.aicoming.top/v1
# 默认 gpt-image-2.5-flare（中文更稳）。备选 gpt-image-2-2k。
IMAGE_MODEL=gpt-image-2.5-flare
# 画幅。竖屏成片改为 9:16，并相应设置 VIDEO_WIDTH / VIDEO_HEIGHT。
# 1:1=1024x1024  16:9=1792x1024  9:16=1024x1792  4:3=1792x1344  3:4=1344x1792
IMAGE_ASPECT=16:9
# 留空则按上面的画幅取尺寸。填写后覆盖画幅映射，例如 1792x1024。
IMAGE_SIZE=
# 单次请求超时，建议 180–600 秒。
IMAGE_TIMEOUT_SEC=300
# 同一集里两张图之间的间隔，避免触发限流。
IMAGE_GAP_SEC=12
# 失败或超时最多尝试次数，两次尝试之间等待 IMAGE_RETRY_WAIT_SEC 秒（约 45–50）。
IMAGE_MAX_ATTEMPTS=6
IMAGE_RETRY_WAIT_SEC=48

# MOSI 多人语音。文档：https://platform.mosi.cn/docs/scenarios/dialogue
# 请求 POST {MOSS_BASE_URL}/v1/audio/speech/speakers ，模型 moss-ttsd-1.0
# 密钥写在 MOSI_API_KEY。旧名 MOSS_API_KEY 仍然可用，两者都有时以 MOSI_API_KEY 为准。
MOSI_API_KEY=
MOSS_API_KEY=
MOSS_BASE_URL=https://api.mosi.cn
MOSS_MODEL=moss-ttsd-1.0
# 同步输出格式：mp3、wav、pcm、flac、aac、opus
MOSS_RESPONSE_FORMAT=wav
# url：返回 JSON 和音频地址；audio：直接返回音频二进制
MOSS_DELIVERY_METHOD=url
# auto：较长台词走异步任务并轮询 GET /v1/audio/tasks/{task_id}；always；never
MOSS_ASYNC=auto
# 同一集逐句合成时，两句之间的间隔，用来躲开限流。mock 配音不等待。
MOSS_GAP_SEC=1.5
# 429、5xx 或超时最多尝试次数。有 Retry-After 时按响应头等待，否则等待 MOSS_RETRY_WAIT_SEC。
MOSS_MAX_ATTEMPTS=4
MOSS_RETRY_WAIT_SEC=8

VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
VIDEO_PRESET=veryfast

# 仅 mock 语音使用，控制每句时长
MOCK_TTS_MIN_SEC=0.6
MOCK_TTS_SEC_PER_CHAR=0.12
MOCK_TTS_MAX_SEC=2.4
